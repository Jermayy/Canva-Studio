# Supabase project URL (Project Settings -> API). Leave both blank to run
# local-only: the app works fully offline but cloud sync is disabled.
RENDERER_VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key. This key is designed to ship in clients;
# per-user isolation is enforced by row-level security, not by this key.
# NEVER put the service_role / secret key here.
RENDERER_VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
